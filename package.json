{
  "name": "finaissistent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente financeiro pessoal no Telegram com Actual Budget",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.mjs",
    "preflight": "node scripts/preflight.mjs",
    "telegram:info": "node scripts/telegram-info.mjs",
    "setup:ai": "node scripts/configure-ai.mjs",
    "test": "node --test --test-isolation=none test/*.test.mjs",
    "test:sdk": "node --test --test-isolation=none test/sdk.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@actual-app/api": "26.9.0",
    "better-sqlite3": "12.11.1",
    "pngjs": "7.0.0"
  }
}
